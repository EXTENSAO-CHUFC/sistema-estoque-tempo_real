# Configuração opcional da versão local.
# Não é necessário criar .env para o primeiro teste: o Compose já possui defaults.

POSTGRES_EXTERNAL_PORT=5434
KAFKA_EXTERNAL_PORT=19090
CONNECT_EXTERNAL_PORT=8083
REDIS_EXTERNAL_PORT=6379
WEB_EXTERNAL_PORT=8000
DASHBOARD_EXTERNAL_PORT=8501

ESTOQUE_MINIMO=20
QUANTIDADE_REABASTECIMENTO=100
REABASTECIMENTO_COOLDOWN_SEGUNDOS=300
DASHBOARD_REFRESH_SECONDS=2
MOVEMENT_HISTORY_LIMIT=500
SIMULATION_INTERVAL_SECONDS=15
